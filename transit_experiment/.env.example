# Server-side only. Used by `transit serve` and `transit fetch-tokyo-metro-status`.
# Copy this file to .env (gitignored); never include the key in browser code.
ODPT_CONSUMER_KEY=

# Optional: JR East GTFS requires a separate ODPT Challenge 2026 token.
# Check challenge-limited usage terms before enabling/publicly serving JR data.
ODPT_CHALLENGE_KEY=
